{
  "expo": {
    "name": "健身日历",
    "slug": "fitness-calendar",
    "scheme": "fitnesscalendar",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "com.fitnesscalendar.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE"
      ],
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#1E293B"
      }
    },
    "ios": {
      "bundleIdentifier": "com.fitnesscalendar.app",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择身体成分报告、营养成分表和食物照片。",
          "cameraPermission": "用于拍摄身体成分报告、营养成分表和食物照片。"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "newArchEnabled": false,
            "extraMavenRepos": [],
            "buildProperties": {
              "reactNativeWorklets.newArchEnabled": "false"
            },
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}